{
  "name": "pi-antigravity",
  "version": "0.1.0",
  "description": "Pi tools for bounded delegation to the official Google Antigravity CLI",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src/",
    "agy-plugin/",
    "scripts/",
    "README.md",
    "PLAN.md",
    "docs/"
  ],
  "keywords": ["pi-package", "pi", "antigravity", "agy"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "static": "node scripts/check-static.mjs",
    "check": "npm run static && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
