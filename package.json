{
  "name": "pi-antigravity",
  "version": "0.1.4",
  "description": "Pi tools for bounded delegation to the official Google Antigravity CLI",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "src/",
    "agy-plugin/",
    "scripts/",
    "README.md",
    "PLAN.md",
    "docs/"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "antigravity",
    "agy"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "static": "node scripts/check-static.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run static && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "7.0.2"
  }
}
